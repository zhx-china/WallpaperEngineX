prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.0.100
Requires: 
Requires.private: libswscale >= 10.0.100, libavformat >= 63.0.100, libavcodec >= 63.0.100, libswresample >= 7.0.100, libavutil >= 61.0.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Cflags: -I${includedir}
