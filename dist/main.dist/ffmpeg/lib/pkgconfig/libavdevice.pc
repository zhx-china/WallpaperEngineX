prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 63.0.100
Requires: 
Requires.private: libavfilter >= 12.0.100, libswscale >= 10.0.100, libavformat >= 63.0.100, libavcodec >= 63.0.100, libswresample >= 7.0.100, libavutil >= 61.0.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Cflags: -I${includedir}
